#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) Application & API
#-------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_POWERBY="Business Monitor API"
NEXT_PUBLIC_API_VERSION="v1"
DISABLE_ERD=true
CHUNK_SIZE=200000

#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) Database (PostgreSQL)
#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) The DATABASE_URL will be used by Prisma.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=business_monitor
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

#-------------------------------------------------------------------------------
# Info: (20251212 - Tzuhan) Security & Identity Authentication (CAFECA Digital ID)
#-------------------------------------------------------------------------------
# Info: (20251212 - Tzuhan) Used for signing session tokens (DeWT).

# Info: (20251212 - Tzuhan) Used for encrypting sensitive data in the database (e.g., Ethereum private keys).
ENCRYPTION_KEY=

# Info: (20251212 - Tzuhan) The origin of the web application for FIDO2/WebAuthn security.
NEXT_PUBLIC_ORIGIN="http://localhost:3000"

# Info: (20251212 - Tzuhan) A generic UUID, can be used for various purposes.
UUID=

#-------------------------------------------------------------------------------
# Info: (20251212 - Tzuhan) Integration Testing
#-------------------------------------------------------------------------------
IT_SAMPLE_NAME_PREFIX="公司"
IT_SAMPLE_REGNO="22099131"

#-------------------------------------------------------------------------------
