#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) Application & API
#-------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_POWERBY="Business Monitor API"
NEXT_PUBLIC_API_VERSION="v1"
DISABLE_ERD=true
CHUNK_SIZE=200000

#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) Database (PostgreSQL)
#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) The DATABASE_URL will be used by Prisma.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=business_monitor
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) Security & Identity Authentication (CAFECA Digital ID)
#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) The following keys will be automatically generated by `scripts/initialize-env.ts` if they are missing.
# Info: (20250917 - Tzuhan) You do not need to set them manually for local development.

# Info: (20250917 - Tzuhan) Used for signing session tokens (DeWT).
JWT_SECRET=

# Info: (20250917 - Tzuhan) Used for encrypting sensitive data in the database (e.g., Ethereum private keys).
ENCRYPTION_KEY=

# Info: (20250917 - Tzuhan) The origin of the web application for FIDO2/WebAuthn security.
NEXT_PUBLIC_ORIGIN=http://localhost:3000

# Info: (20250917 - Tzuhan) A generic UUID, can be used for various purposes.
UUID=

#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) Third-party Services
#-------------------------------------------------------------------------------
I18NEXUS_API_KEY=

#-------------------------------------------------------------------------------
# Info: (20250917 - Tzuhan) Frontend Display & Contact Information
#-------------------------------------------------------------------------------
CAFECA_COPYRIGHT="CAFECA Inc. © 2017 - 2025 All rights reserved."
CAFECA_LOCATION_EN="14 F., No. 521, Sec. 4, Xinyi Rd., Xinyi Dist., Taipei City 110053, Taiwan"
CAFECA_LOCATION_CH="110053 臺北市信義區忠孝東路四段 521 號 14 樓"
CAFECA_LOCATION_MAP="https://maps.app.goo.gl/u7cbstA8q7XbMaDK6"
CAFECA_PHONE="+886-2-25466225"
CAFECA_FACEBOOK_LINK=""
CAFECA_TWITTER_LINK=""
CAFECA_LINKEDIN_LINK=""
CAFECA_GITHUB_LINK="https://github.com/CAFECA-IO"
