{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "ignition/**/*.ts",
    "hardhat.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
